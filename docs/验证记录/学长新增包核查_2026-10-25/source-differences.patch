+# 2026 场地只有 4 m x 4 m，固定障碍之间最窄的通道约 0.4 m。原来的
+#   footprint 0.8 x 0.8 / inflation_radius 0.6
+# 在图纸上等于“任何一边留 1 m”，整张图没有一条可走的路（旧航点就是这样
+# 全部规划失败的）。机体系 0.32 m 见方、外扩 0.25 m 是按 4 m 场地和
+# 0.4 m 通道反推的上限：再大就穿不过随机障碍和固定墙之间的缝。
+obstacle_range: 3.0
+raytrace_range: 3.5
+
+footprint: [[0.16, 0.16], [0.16, -0.16], [-0.16, -0.16], [-0.16, 0.16]]
+#robot_radius: 0.16
+
+inflation_radius: 0.25
+cost_scaling_factor: 3.0
+
+map_type: costmap
+observation_sources: scan
+scan: {sensor_frame: laser_link, data_type: LaserScan, topic: scan, marking: true, clearing: true}
