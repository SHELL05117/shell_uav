+u_result Thread::terminate()
+{
+    if (!this->_handle) return RESULT_OK;
+    if (TerminateThread( reinterpret_cast<HANDLE>(this->_handle), -1))
+    {
+        CloseHandle(reinterpret_cast<HANDLE>(this->_handle));
