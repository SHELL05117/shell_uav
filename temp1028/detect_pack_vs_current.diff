+int Detect::expectedChannels() const
+{
+  const int classes = static_cast<int>(labels_.size());
+  if (yolo_style_ == "v8-dfl") return 4 * std::max(1, yolo_reg_max_) + classes;
+  if (yolo_style_ == "v5-split") return 3 * (4 + classes);
+  return 3 * (5 + classes);
 }
 
