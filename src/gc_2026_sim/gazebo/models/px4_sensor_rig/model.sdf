<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="px4_sensor_rig">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <gravity>false</gravity>
      <!-- MUST NOT be kinematic: Gazebo silently refuses /gazebo/set_model_state
           on kinematic models, so px4_sensor_rig_node can never move this rig
           to follow the iris. The lidar would then stay at its spawn point
           while the drone flies away, which makes Cartographer publish a
           drifting map->odom and the mission abort. Keep it dynamic
           (gravity off, no collision) and drive it purely via set_model_state. -->
      <kinematic>false</kinematic>
      <visual name="rig_visual">
        <geometry><box><size>0.08 0.08 0.04</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <sensor name="horizontal_lidar" type="ray">
        <pose>0 0 0.25 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>3.50</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="px4_sensor_rig_laser_plugin"
                filename="libgazebo_ros_laser.so">
          <topicName>/scan</topicName>
          <frameName>laser_link</frameName>
        </plugin>
      </sensor>
    </link>

    <link name="camera_link">
      <gravity>false</gravity>
      <!-- dynamic for the same reason as base_link above -->
      <kinematic>false</kinematic>
      <pose>0 0 -0.15 0 1.5708 0</pose>
      <sensor name="rgb_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>10.0</far></clip>
        </camera>
        <plugin name="px4_sensor_rig_camera_plugin"
                filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>camera</cameraName>
          <imageTopicName>/camera/image_raw</imageTopicName>
          <cameraInfoTopicName>/camera/camera_info</cameraInfoTopicName>
          <frameName>camera_link</frameName>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_mount" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
