<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="sim_quadrotor">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial>
        <mass>1.5</mass>
        <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.32 0.32 0.12</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.32 0.32 0.12</size></box></geometry>
        <material><ambient>0.08 0.08 0.10 1</ambient><diffuse>0.12 0.12 0.16 1</diffuse></material>
      </visual>
      <sensor name="scan" type="ray">
        <pose>0 0 0.08 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>3.5</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="sim_laser_plugin" filename="libgazebo_ros_laser.so">
          <topicName>/scan</topicName>
          <frameName>base_link</frameName>
        </plugin>
      </sensor>
    </link>
    <link name="rotor_front_left">
      <gravity>false</gravity><kinematic>true</kinematic>
      <pose>0.1591 0.1591 0.06 0 0 0</pose>
      <visual name="rotor"><geometry><cylinder><radius>0.13</radius><length>0.02</length></cylinder></geometry><material><ambient>0.05 0.35 0.90 1</ambient><diffuse>0.05 0.45 1.0 1</diffuse></material></visual>
    </link>
    <link name="rotor_front_right">
      <gravity>false</gravity><kinematic>true</kinematic>
      <pose>0.1591 -0.1591 0.06 0 0 0</pose>
      <visual name="rotor"><geometry><cylinder><radius>0.13</radius><length>0.02</length></cylinder></geometry><material><ambient>0.05 0.35 0.90 1</ambient><diffuse>0.05 0.45 1.0 1</diffuse></material></visual>
    </link>
    <link name="rotor_back_left">
      <gravity>false</gravity><kinematic>true</kinematic>
      <pose>-0.1591 0.1591 0.06 0 0 0</pose>
      <visual name="rotor"><geometry><cylinder><radius>0.13</radius><length>0.02</length></cylinder></geometry><material><ambient>0.05 0.35 0.90 1</ambient><diffuse>0.05 0.45 1.0 1</diffuse></material></visual>
    </link>
    <link name="rotor_back_right">
      <gravity>false</gravity><kinematic>true</kinematic>
      <pose>-0.1591 -0.1591 0.06 0 0 0</pose>
      <visual name="rotor"><geometry><cylinder><radius>0.13</radius><length>0.02</length></cylinder></geometry><material><ambient>0.05 0.35 0.90 1</ambient><diffuse>0.05 0.45 1.0 1</diffuse></material></visual>
    </link>
    <link name="camera_link">
      <gravity>false</gravity><kinematic>true</kinematic>
      <pose>0 0 -0.12 0 1.5708 0</pose>
      <visual name="camera"><geometry><box><size>0.08 0.08 0.08</size></box></geometry><material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <sensor name="downward_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>10.0</far></clip>
        </camera>
        <plugin name="sim_camera_plugin" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>sim_camera</cameraName>
          <imageTopicName>/sim_camera/image_raw</imageTopicName>
          <cameraInfoTopicName>/sim_camera/camera_info</cameraInfoTopicName>
          <frameName>camera_link</frameName>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
