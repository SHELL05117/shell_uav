<?xml version="1.0"?>
<package format="2">
  <name>navigation_2d</name>
  <version>0.2.0</version>
  <description>2026 fire-and-rescue mission: field-frame waypoints, RKNN detection, two-stage drops.</description>

  <maintainer email="expload233@gmail.com">expload</maintainer>
  <author email="expload233@gmail.com">expload</author>
  <license>proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>actionlib</depend>
  <depend>move_base_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>move_base</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>servo_control</exec_depend>
