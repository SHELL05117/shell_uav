<launch>


  <arg name="open_rviz" default="false" />
  <arg name="drone_frame" default="base_link" />
  <arg name="odom_frame" default="odom" />

  <!-- RPLIDAR S2：USB 转串口，S2 固定 1 Mbaud -->
  <arg name="lidar_serial_port" default="/dev/ttyUSB0" />
  <arg name="node_start_delay" default="3.0" />
  <arg name="height_profile" default="" />

  <!-- Clearance and body-FLU sensor geometry must be measured before marking
       the reference calibrated. IMU tilt projects the beam onto vertical.
       Missing/stale TFmini or IMU withholds vision_pose; no SLAM-z fallback. -->
  <arg name="use_tf_mini" default="true" />
  <arg name="tf_mini_type" default="i2c" />
  <arg name="tf_mini_height" default="0.09" />
  <arg name="height_reference_calibrated" default="false" />
  <arg name="sensor_offset_x" default="0.0" />
  <arg name="sensor_offset_y" default="0.0" />
  <arg name="sensor_offset_z" default="0.0" />
  <arg name="sensor_beam_x" default="0.0" />
  <arg name="sensor_beam_y" default="0.0" />
  <arg name="sensor_beam_z" default="-1.0" />
  <arg name="imu_topic" default="/mavros/imu/data" />
  <!-- I2C6 / 0x10 real ranging verified 2026-10-27; height geometry stays uncalibrated. -->
  <arg name="bus" default="6" />
  <arg name="address" default="16" />
  <arg name="serial_port" default="/dev/ttyUSB0" />
  <arg name="baud_rate" default="115200" />

  <!-- Pixhawk 6C：PX4 的 USB 默认 921600（USB CDC 本身忽略波特率，但 MAVROS 要匹配） -->
  <arg name="fcu_url" default="/dev/ttyACM0:921600" />
  <arg name="gcs_url" default="tcp-l://0.0.0.0:5760" />

  <include file="$(find location)/launch/rplidar.launch">
    <arg name="serial_port" value="$(arg lidar_serial_port)" />
  </include>

  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="gcs_url" value="$(arg gcs_url)" />
  </include>

  <node pkg="location" type="location_node" name="location_node" output="screen"
        launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@' ">
    <param name="publish_rate" value="20" />

    <param name="target_frame_id" value="$(arg odom_frame)" />
    <param name="source_frame_id" value="$(arg drone_frame)" />

    <param name="use_tf_mini" value="$(arg use_tf_mini)" />
    <param name="tf_mini_type" value="$(arg tf_mini_type)" />
    <param if="$(eval arg('height_profile') == '')" name="tf_mini_height" value="$(arg tf_mini_height)" />
    <param if="$(eval arg('height_profile') == '')" name="height_reference_calibrated" value="$(arg height_reference_calibrated)" />
    <param if="$(eval arg('height_profile') == '')" name="sensor_offset_x" value="$(arg sensor_offset_x)" />
    <param if="$(eval arg('height_profile') == '')" name="sensor_offset_y" value="$(arg sensor_offset_y)" />
    <param if="$(eval arg('height_profile') == '')" name="sensor_offset_z" value="$(arg sensor_offset_z)" />
    <param if="$(eval arg('height_profile') == '')" name="sensor_beam_x" value="$(arg sensor_beam_x)" />
    <param if="$(eval arg('height_profile') == '')" name="sensor_beam_y" value="$(arg sensor_beam_y)" />
    <param if="$(eval arg('height_profile') == '')" name="sensor_beam_z" value="$(arg sensor_beam_z)" />
    <param name="imu_topic" value="$(arg imu_topic)" />
    <param name="bus" value="$(arg bus)" />
    <param name="address" value="$(arg address)" />
    <param name="serial_port" value="$(arg serial_port)" />
    <param name="baud_rate" value="$(arg baud_rate)" />
    <rosparam if="$(eval arg('height_profile') != '')" command="load" file="$(arg height_profile)" />
  </node>

  <include file="$(find location)/launch/cartographer_2d.launch" />

  <!-- 雷达安装：S2 相对机头转了 180°，与旧机一致 -->
  <node pkg="tf" type="static_transform_publisher" name="tf_baselink_to_laserlink"
        args="0 0 0 3.14159 0 0 base_link laser_link 30" />

  <group if="$(arg open_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" required="true"
          args="-d $(find location)/rviz/ros_navigation.rviz" />
  </group>
</launch>
