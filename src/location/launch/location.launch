<launch>
	<arg name="is_simulation" default="false" />
	<arg name="open_rviz" default="false" />
	<arg name="load_model" default="false" />

	<!-- rplidar_location: true for rplidar; false for t265 -->
	<arg name="rplidar_location" default="true" />

	<arg name="drone_frame" default="base_link" />
	<arg name="odom_frame" default="odom" />

	<!-- set the type of rplidar, true:S2, false:default:A2/A3 -->
	<arg name="S2" default="true" />
	<arg name="lidar_serial_port" default="/dev/ttyUSB0" />

	<arg name="node_start_delay" default="3.0" />
	<arg name="use_tf_mini" default="true" />
	<arg name="tf_mini_type" default="i2c" />
	<arg name="tf_mini_height" default="0.09" />
	<!--arg
	name="tf_mini_type" default="usb" /-->

	<!-- NX -->
	<!-- <arg name="bus" default="1" />  -->
	<!-- Nano -->
	<arg name="bus" default="0" />
	<arg name="address" default="16" />


	<arg name="serial_port" default="/dev/ttyTHS0" />
	<!--arg
	name="serial_port" default="/dev/ttyUSB1" /-->
	<arg name="baud_rate" default="115200" />

	<group unless="$(arg is_simulation)">
		<include unless="$(arg rplidar_location)" file="$(find location)/launch/rs_t265.launch">
			<arg name="fisheye_width" value="848" />
			<arg name="fisheye_height" value="800" />
			<arg name="enable_fisheye1" value="true" />
			<arg name="enable_fisheye2" value="true" />
			<arg name="fisheye_fps" value="30" />

			<arg name="gyro_fps" value="200" />
			<arg name="accel_fps" value="62" />

			<arg name="publish_odom_tf" value="true" />
			<arg name="base_frame_id" value="$(arg drone_frame)" />
			<arg name="odom_frame_id" value="$(arg odom_frame)" />
			<!-- -->
		</include>

		<include if="$(arg rplidar_location)" file="$(find location)/launch/rplidar.launch">
			<arg name="S2" value="$(arg S2)" />
			<arg name="serial_port" value="$(arg lidar_serial_port)" />
			<!-- <arg name="lidar_topic" value="$(arg lidar_topic)" /> -->
		</include>

		<include file="$(find mavros)/launch/px4.launch">
			<arg name="fcu_url" value="/dev/ttyACM0:57600" />
			<arg name="gcs_url" value="tcp-l://0.0.0.0:5760" />
		</include>
	</group>


	<node pkg="location" type="location_node" name="location_node" output="screen"
		launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@' ">
		<param name="is_simulation" value="$(arg is_simulation)" />
		<param name="rplidar_location" value="$(arg rplidar_location)" />
		<param name="publish_rate" value="20" />

		<param name="target_frame_id" value="$(arg odom_frame)" />
		<param name="source_frame_id" value="$(arg drone_frame)" />
		<param name="roll_obj" value="0" />
		<param name="pitch_obj" value="0" />
		<param name="yaw_obj" value="0" />

		<param name="use_tf_mini" value="$(arg use_tf_mini)" />
		<param name="tf_mini_type" value="$(arg tf_mini_type)" />
		<param name="bus" value="$(arg bus)" />
		<param name="address" value="$(arg address)" />


		<param name="serial_port" value="$(arg serial_port)" />
		<param name="baud_rate" value="$(arg baud_rate)" />
	</node>

	<include if="$(arg rplidar_location)" file="$(find location)/launch/cartographer_2d.launch">
		<arg name="rplidar_location" value="$(arg rplidar_location)" />
	</include>

	<group if="$(arg rplidar_location)">
		<group unless="$(arg load_model)">
			<node pkg="tf" type="static_transform_publisher" name="tf_baselink_to_laserlink"
				args="0 0 0 3.14159 0 0 base_link laser_link 30" />
		</group>

		<group if="$(arg load_model)">
			<!-- 加载urdf以便在rviz上显示uav模型 -->
			<arg name="mavlink_udp_port" default="14560" />
			<arg name="rotors_description_dir" default="$(find location)/urdf/iris_depth_camera" />
			<arg name="model" default="$(arg rotors_description_dir)/xacro/iris_base.xacro" />
			<arg name="cmd"
				default="$(find xacro)/xacro rotors_description_dir:=$(arg rotors_description_dir) $(arg model) mavlink_udp_port:=$(arg mavlink_udp_port) --inorder" />
			<param command="$(arg cmd)" name="robot_description" />

			<node name="joint_state_publisher" pkg="joint_state_publisher"
				type="joint_state_publisher">
				<param name="rate" value="20.0" />
			</node>

			<node name="robot_state_publisher" pkg="robot_state_publisher"
				type="robot_state_publisher">
				<param name="rate" value="20.0" />
			</node>
		</group>

		<group if="$(arg open_rviz)">
			<node pkg="rviz" type="rviz" name="rviz" required="true"
				args="-d $(find location)/rviz/ros_navigation.rviz" />
		</group>
	</group>

</launch>