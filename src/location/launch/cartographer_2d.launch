<launch>
  <!-- 2D 激光 SLAM：用 S2 的扫描 + PX4 IMU 做扫描匹配。
       配置：param/ROSSLAM/cartographer_2Dlidar_mapping_location_params.lua
         tracking_frame = base_link, published_frame = base_link,
         odom_frame = odom, provide_odom_frame = true
       所以 cartographer 自己发 map->odom 和 odom->base_link 两条 TF，
       location_node 读 odom->base_link。 -->
  <arg name="node_start_delay" default="6.0" />

  <node name="cartographer_node" pkg="cartographer_ros" type="cartographer_node"
        output="screen"
        launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@'"
        args="-configuration_directory $(find location)/param/ROSSLAM
              -configuration_basename cartographer_2Dlidar_mapping_location_params.lua">
    <remap from="scan" to="/scan" />
    <remap from="imu" to="/mavros/imu/data" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node"
        launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@'"
        args="-resolution 0.05 -publish_period_sec 1.0" />
</launch>
