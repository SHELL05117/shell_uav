<launch>

  <!-- <param name="/use_sim_time" value="true"/> -->

  <!-- rplidar_location: true for rplidar; false for t265 -->
  <arg name="rplidar_location" default="false" />
  <arg name="node_start_delay" value="6.0" />
  <!--cartographer
  2d lidar mapping 使用robot的里程计进行校正-->
  <node unless="$(arg rplidar_location)" name="cartographer_node" pkg="cartographer_ros"
    type="cartographer_node" launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@'"
    args="
          -configuration_directory  $(find location)/param/ROSSLAM
          -configuration_basename cartographer_2Dlidar_mapping_params.lua"
    output="screen">
    <!-- <remap from="scan" to="/lidar2Dscan" /> -->
    <remap from="odom" to="/mavros/local_position/odom" />
    <remap from="imu" to="/mavros/imu/data" />
  </node>

  <node if="$(arg rplidar_location)" name="cartographer_node" pkg="cartographer_ros"
    type="cartographer_node" launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@'"
    args="
          -configuration_directory  $(find location)/param/ROSSLAM
          -configuration_basename cartographer_2Dlidar_mapping_location_params.lua"
    output="screen">
    <!-- <remap from="scan" to="/lidar2Dscan" /> -->
    <remap from="imu" to="/mavros/imu/data" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
    type="cartographer_occupancy_grid_node" args="-resolution 0.05" />

</launch>