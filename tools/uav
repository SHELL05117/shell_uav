#!/usr/bin/env bash
set -eo pipefail
uav_dir="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
source "$uav_dir/uav_env.sh"
if [[ "${1:-}" == logs ]]; then
  shift
  if (( $# == 0 )); then set -- status; fi
  exec python2 "$uav_dir/uav_log.py" "$@"
fi
exec python2 "$uav_dir/uav_start.py" "$@"
